# Optional. When set, the graph's reasoning nodes call Claude via
# langchain-anthropic. When unset, a deterministic offline mock is used so the
# repo runs end-to-end with zero credentials (tests, CI, sweeps all work offline).
ANTHROPIC_API_KEY=

# Optional. MLflow backend. Defaults to a local sqlite db (sqlite:///mlflow.db).
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Optional. Snowflake Cortex Search (production retrieval path) — only needed if
# you wire up the CortexRetriever adapter.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=AI
# SNOWFLAKE_SCHEMA=MEMBER_BENEFITS_ASSISTANT
